{
  "schema_version": 1,
  "implementation": "alcf",
  "configuration": {
    "api_version": 1,
    "resource_server": "6be511f6-a071-471f-9bc0-02a0d0836723",
    "api_base": "https://api.alcf.anl.gov/api/v1",
    "status_resources_supports_filters": false,
    "storage_iriapi_group": "storages",
    "storage_resource_type": "storage",
    "unsupported_filesystem_operations": {
      "uploadBytes": "globus",
      "downloadFile": "globus",
      "downloadFileContents": "globus",
      "pathStat": "skip"
    },
    "filesystems": {
      "alcf_home": {
        "description": "ALCF home filesystem mounted by Polaris, Sophia, and Crux; Aurora has a separate /home that IRI and Globus do not expose",
        "storage_resource_paths": [
          {
            "filesystem_roots": [
              "/home"
            ],
            "resource_name": "Home"
          }
        ],
        "globus_filesystems": [
          {
            "filesystem_roots": [
              "/home"
            ],
            "endpoint": "9032dd3a-e841-4687-a163-2720da731b5b",
            "globus_root": "/",
            "requires_data_access": true
          }
        ]
      },
      "alcf_flare": {
        "description": "ALCF Flare project filesystem",
        "storage_resource_paths": [
          {
            "filesystem_roots": [
              "/flare",
              "/lus/flare"
            ],
            "resource_name": "Flare"
          }
        ],
        "globus_filesystems": [
          {
            "filesystem_roots": [
              "/lus/flare/projects",
              "/flare"
            ],
            "endpoint": "f39a7a0f-5bfc-46ce-9615-ba9f8592814f",
            "globus_root": "/",
            "requires_data_access": true
          }
        ]
      },
      "alcf_eagle": {
        "description": "ALCF Eagle project filesystem",
        "storage_resource_paths": [
          {
            "filesystem_roots": [
              "/eagle",
              "/lus/eagle"
            ],
            "resource_name": "Eagle"
          }
        ],
        "globus_filesystems": [
          {
            "filesystem_roots": [
              "/lus/eagle/projects",
              "/eagle"
            ],
            "endpoint": "05d2c76a-e867-4f67-aa57-76edeb0beda0",
            "globus_root": "/",
            "requires_data_access": true
          }
        ]
      }
    },
    "required_scopes": [
      "https://auth.globus.org/scopes/6be511f6-a071-471f-9bc0-02a0d0836723/filesystem"
    ],
    "session_policy": "a128e981-c9a5-417a-97ab-8571c9831bff",
    "machines": {
      "polaris": {
        "iriapi_group": "computes",
        "iriapi_resource_name": "Polaris",
        "custom_attributes": {
          "filesystems": "home:eagle"
        },
        "mounted_filesystems": [
          "alcf_home",
          "alcf_eagle"
        ],
        "queues": [
          [
            "debug",
            "1-2 nodes, 5 minutes-1 hour; max 24 nodes in use"
          ],
          [
            "debug-scaling",
            "1-10 nodes, 5 minutes-1 hour; max one job per user"
          ],
          [
            "prod",
            "10-496 nodes, 5 minutes-24 hours; routing queue"
          ],
          [
            "preemptable",
            "1-10 nodes, 5 minutes-72 hours; may be killed for demand jobs; max 20 jobs per project"
          ],
          [
            "demand",
            "1-56 nodes, 5 minutes-1 hour; by request only; max 100 jobs per project"
          ],
          [
            "capacity",
            "1-4 nodes, 5 minutes-7 days; max 32 nodes and one running job per user"
          ]
        ]
      },
      "aurora": {
        "iriapi_group": "computes",
        "iriapi_resource_name": "Aurora",
        "custom_attributes": {
          "filesystems": "flare"
        },
        "mounted_filesystems": [
          "alcf_flare"
        ],
        "queues": [
          [
            "debug",
            "1-2 nodes, 5 minutes-1 hour; max one job per user"
          ],
          [
            "debug-scaling",
            "2-256 nodes, 5 minutes-1 hour; max one job per user"
          ],
          [
            "prod",
            "256-10,624 nodes, 5 minutes-24 hours; routing queue"
          ],
          [
            "capacity",
            "1-16 nodes, 5 minutes-7 days; max 512 nodes and two running jobs per user"
          ]
        ]
      }
    }
  },
  "metadata": {
    "source": "packaged"
  }
}
